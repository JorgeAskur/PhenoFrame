# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Generated outputs
plants/*.obj
plants/*.mtl
plants/separated/
plants/leaves_separated/
traits.xml
examples/output/
.ipynb_checkpoints/

# Experiment outputs (figures, intermediate CSVs, fitted descriptors) — the
# experiment notebooks and scripts ARE tracked; their generated artifacts are not.
experiments/**/figures/
experiments/**/outputs*/
experiments/**/fitted_descriptors/
experiments/**/_executed*/

# Regenerable C++ plant exports (deterministic, rebuilt via _gen_plantscpp.py /
# MaizeGenerator) — do not commit the meshes/descriptors themselves.
experiments/PlantsC++/
experiments/**/plant_export*/

# Local convenience junction (mklink /J 01_phyllotaxis -> results); the real
# notebooks live in results/. Committing the junction would duplicate them.
experiments/experiments/01_phyllotaxis/

# Local user data (external datasets are never redistributed)
experiments/**/data/external/
experiments/data/external/

# IDE / tool config
.claude/
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store

# Logs and local build backups
*.log
*.bak

# Build artifacts (keep bundled binaries in phenosuite/libs/ for distribution)
MaizeModel/build/

# Sorghum (separate project)
SorghumModel/
SorghumWrapper.py
test_SorghumPM.py

# The stochastic generator lives in its own repository (MaizeProceduralModel),
# consumed here via the phenosuite.MaizeGenerator wrapper — not vendored in.
MaizeProceduralModel/