<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema for the PyMaize plant descriptor format.

  Validates the structure and required attributes of <plant> documents. 
  Numeric attributes are typed but not range-checked beyond the C++ 
  engine's hardcoded clamps (e.g. splinePoints in [4, 40]).

  Spline elements (<stemCtrl>, <ctrlCenter>) carry a positional set of
  attributes named p{i}x/p{i}y/p{i}z for i in [0, count-1]; XSD cannot
  pattern-match these directly, so we accept any extra attributes via
  xs:anyAttribute and rely on the parser to read them by index.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="plant">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="species"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="species">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Tiller" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Tiller">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="stemCtrl" minOccurs="0"/>
        <xs:element ref="leaves" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string" default="main"/>
      <xs:attribute name="radius" type="xs:float" use="required"/>
      <xs:attribute name="alpha" type="xs:float" default="0.0"/>
      <xs:attribute name="beta" type="xs:float" default="180.0"/>
      <xs:attribute name="stemShrink" type="xs:float" default="0.001"/>
      <xs:attribute name="randomSeed" type="xs:unsignedInt" default="1337"/>
      <xs:attribute name="useStemCtrlOverrides" type="xs:integer" default="0"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="leaves">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="leaf" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="number" type="xs:integer"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="leaf">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ctrlCenter" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:integer" use="required"/>
      <xs:attribute name="distance" type="xs:float" use="required"/>
      <xs:attribute name="leafLength" type="xs:float" use="required"/>
      <xs:attribute name="leafWidth" type="xs:float" use="required"/>
      <xs:attribute name="leafAngle" type="xs:float" use="required"/>
      <xs:attribute name="droopiness" type="xs:float" default="0.0"/>
      <xs:attribute name="stemInclinationDeg" type="xs:float" default="0.0"/>
      <xs:attribute name="splinePoints" type="xs:integer" default="4"/>
      <xs:attribute name="widthTaper" type="xs:float" default="1.0"/>
      <xs:attribute name="leafTwist" type="xs:float" default="0.0"/>
      <xs:attribute name="leafCurl" type="xs:float" default="0.0"/>
      <xs:attribute name="waveLAmp" type="xs:float" default="0.0"/>
      <xs:attribute name="waveLFreq" type="xs:float" default="0.0"/>
      <xs:attribute name="waveLPhase" type="xs:float" default="0.0"/>
      <xs:attribute name="waveRAmp" type="xs:float" default="0.0"/>
      <xs:attribute name="waveRFreq" type="xs:float" default="0.0"/>
      <xs:attribute name="waveRPhase" type="xs:float" default="0.0"/>
      <xs:attribute name="useCtrlOverrides" type="xs:integer" default="0"/>
    </xs:complexType>
  </xs:element>

  <!-- Spline control-point payloads. The dynamic p{i}x / p{i}y / p{i}z
       attributes (i in [0, count-1]) are accepted via anyAttribute. -->
  <xs:element name="stemCtrl">
    <xs:complexType>
      <xs:attribute name="count" type="xs:integer" use="required"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ctrlCenter">
    <xs:complexType>
      <xs:attribute name="count" type="xs:integer" use="required"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
